# ---------------------------------------------------------------
# 依赖与构建产物（可重建，不入库）
# ---------------------------------------------------------------
node_modules/
prototype/node_modules/
dist/
prototype/dist/
prototype/sea-prep.blob
prototype/.sea-build-*/
prototype/.sea-exe-*/
prototype/.tmp/
prototype/.tmp-*
*.log

# ---------------------------------------------------------------
# 打包 / 发行产物（体积过大，不入库）
#   正式版由 `npm run release` 生成，发行版由 `npm run dist` 生成。
#   WhiteBoard.exe 约 115 MB，超过 GitHub 单文件 100 MB 限制，只能走 Release 附件。
# ---------------------------------------------------------------
prototype/WhiteBoard.exe
release/
ZhaDaoBoard/
*.exe

# ---------------------------------------------------------------
# 用户数据（含个人白板 / 图片 / 素材库，绝对不入库）
# ---------------------------------------------------------------
data/
prototype/data/
release/data/

# ---------------------------------------------------------------
# 大体积字体源（阿里巴巴普惠体，约 93 MB）
#   仅 `npm run build:fonts` 重新子集化时需要；运行时用的是已入库的
#   prototype/public/fonts/puhuiti/。Xiaolai 为引擎自带的中文回退分片，
#   本项目已用构建期补丁改绑字体槽位，不再需要，故不随仓库分发。
# ---------------------------------------------------------------
/fonts/
prototype/public/fonts/Xiaolai/

# ---------------------------------------------------------------
# 工作区本地目录 / 系统文件
# ---------------------------------------------------------------
.workbuddy-ai/
.vscode/
.idea/
.DS_Store
Thumbs.db
